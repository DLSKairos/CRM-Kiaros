# Base de datos — elige cualquier contraseña segura
POSTGRES_PASSWORD=cambia_esto_por_algo_seguro

# Proveedor de IA: "anthropic" o "groq"
AI_PROVIDER=groq

# Anthropic — requerido si AI_PROVIDER=anthropic
# Consíguelo en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Groq — requerido si AI_PROVIDER=groq (gratis en groq.com)
GROQ_API_KEY=gsk_...

# Tavily — búsqueda web para agentes (gratis: 1000/mes en tavily.com)
TAVILY_API_KEY=tvly-...

# Notificaciones — opcionales en Fase 1, requeridos en Fase 3
# Resend (email digest): https://resend.com/
RESEND_API_KEY=re_...

# Slack webhook (alertas en tiempo real): https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Frontend — no cambiar en desarrollo local
NEXT_PUBLIC_API_URL=http://localhost:8000
